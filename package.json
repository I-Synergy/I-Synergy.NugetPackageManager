{
  "name": "i-synergy-nugetpackagemanager",
  "publisher": "I-Synergy",
  "displayName": "I-Synergy NuGet Package Manager",
  "description": "A comprehensive NuGet package management extension for Visual Studio Code with vulnerability scanning, multi-project support, and version consolidation.",
  "version": "1.2.7",
  "license": "MIT",
  "icon": "docs/images/icon.png",
  "galleryBanner": {
    "color": "#6366f1",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.110.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "keywords": [
    "nuget",
    "dotnet",
    "package manager",
    "csharp",
    "dependency management"
  ],
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "homepage": "https://github.com/I-Synergy/I-Synergy.NugetPackageManager",
  "bugs": {
    "url": "https://github.com/I-Synergy/I-Synergy.NugetPackageManager/issues",
    "email": "daniel-rck@proton.me"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/I-Synergy/I-Synergy.NugetPackageManager.git"
  },
  "activationEvents": [
    "workspaceContains:**/*.csproj",
    "workspaceContains:**/*.fsproj",
    "workspaceContains:**/*.sln",
    "workspaceContains:**/*.slnx",
    "onWebviewPanel:nugetpackage.panel",
    "workspaceContains:**/*.vbproj"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "nugetpackage.open",
        "title": "NuGet Package Manager: Open Packages"
      },
      {
        "command": "nugetpackage.install",
        "title": "NuGet Package Manager: Add Package"
      },
      {
        "command": "nugetpackage.update",
        "title": "NuGet Package Manager: Update Package"
      },
      {
        "command": "nugetpackage.remove",
        "title": "NuGet Package Manager: Remove Package"
      },
      {
        "command": "nugetpackage.openSettings",
        "title": "Settings",
        "icon": "$(extensions-manage)"
      },
      {
        "command": "nugetpackage.reportProblem",
        "title": "Report Problem",
        "icon": "$(report)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "nugetpackage.reportProblem",
          "when": "view == i-synergy-nugetpackagemanager.launcherView",
          "group": "navigation@1"
        },
        {
          "command": "nugetpackage.openSettings",
          "when": "view == i-synergy-nugetpackagemanager.launcherView",
          "group": "navigation@2"
        }
      ],
      "editor/title": [
        {
          "command": "nugetpackage.openSettings",
          "when": "activeWebviewPanelId == nugetpackage.panel",
          "group": "navigation@1"
        },
        {
          "command": "nugetpackage.reportProblem",
          "when": "activeWebviewPanelId == nugetpackage.panel",
          "group": "navigation@2"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "i-synergy-nugetpackagemanager",
          "title": "NuGet",
          "icon": "resources/nuget.svg"
        }
      ]
    },
    "views": {
      "i-synergy-nugetpackagemanager": [
        {
          "id": "i-synergy-nugetpackagemanager.launcherView",
          "name": "NuGet",
          "when": "nuget.hasSupportedProjects"
        }
      ]
    },
    "configuration": {
      "title": "NuGet Package Manager",
      "properties": {
        "i-synergy-nugetpackagemanager.skipRestore": {
          "type": "boolean",
          "default": false,
          "description": "Skip performing a restore preview and compatibility check"
        },
        "i-synergy-nugetpackagemanager.sources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "minItems": 1,
          "default": [
            "{\"name\": \"nuget.org\",\"url\": \"https://api.nuget.org/v3/index.json\"}"
          ],
          "description": "NuGet sources"
        },
        "i-synergy-nugetpackagemanager.passwordScriptAllowlist": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine",
          "description": "Machine-scoped directories from which password scripts may be executed. Workspace-provided script paths outside this allowlist are refused."
        },
        "i-synergy-nugetpackagemanager.logLevel": {
          "type": "string",
          "default": "INFO",
          "enum": [
            "DEBUG",
            "INFO",
            "WARN",
            "ERROR"
          ],
          "description": "Minimum logging level"
        },
        "i-synergy-nugetpackagemanager.enablePackageVersionInlineInfo": {
          "type": "boolean",
          "default": false,
          "description": "Show inline information about newer package versions in project files"
        },
        "i-synergy-nugetpackagemanager.prerelease": {
          "type": "boolean",
          "default": false,
          "description": "Include prerelease versions when checking for package updates"
        },
        "i-synergy-nugetpackagemanager.statusBarLoadingIndicator": {
          "type": "boolean",
          "default": false,
          "description": "Show a loading indicator in the status bar when loading packages"
        },
        "i-synergy-nugetpackagemanager.enableTelemetry": {
          "type": "boolean",
          "default": false,
          "description": "Send anonymous usage telemetry to the configured OTLP endpoint. Requires VS Code telemetry to be enabled and a TELEMETRY_ADDRESS environment variable."
        },
        "i-synergy-nugetpackagemanager.frameworkAlignedPackages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "Microsoft.Extensions.*",
            "Microsoft.AspNetCore.*",
            "Microsoft.EntityFrameworkCore.*",
            "Microsoft.Maui.*",
            "System.*"
          ],
          "description": "Package patterns whose major version follows the target framework (net10.0 to 10.x). Used to keep framework-scoped update suggestions on the matching major line."
        },
        "i-synergy-nugetpackagemanager.extraTargetFrameworks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Target frameworks to add when MSBuild evaluation is unavailable or incomplete (for example net11.0)."
        },
        "i-synergy-nugetpackagemanager.excludeGlobs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/bin/**",
            "**/obj/**",
            "**/TestResults/**",
            "**/packages/**",
            "**/.git/**"
          ],
          "description": "Glob patterns excluded from project discovery."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node ./esbuild.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vscode-test",
    "pretest": "npm run test-compile",
    "esbuild": "node ./esbuild.js",
    "dev": "node ./esbuild.js && node ./tools/dev-server.mjs",
    "test-compile": "tsc -p ./tsconfig.test.json",
    "package": "vsce package --no-dependencies --out releases/",
    "docs": "node ./tools/generate-docs.mjs",
    "release": "node tools/release.mjs",
    "screenshot": "node tools/take-screenshots.mjs"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.0",
    "@types/lodash": "^4.17.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.19.43",
    "@types/sinon": "^22.0.1",
    "@types/vscode": "^1.110.0",
    "@types/vscode-webview": "^1.57.5",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.0.0",
    "sinon": "^22.1.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  },
  "overrides": {
    "@tsconfig/node14": "1.0.3",
    "bidi-js": "1.0.3",
    "core-util-is": "1.0.3",
    "glob": "13.0.6",
    "serialize-javascript": "7.0.3",
    "diff": "8.0.3",
    "@azure/msal-node": "7.1.1",
    "@azure/identity": "4.14.0"
  },
  "dependencies": {
    "@lit/task": "^1.0.3",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.213.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@xmldom/xmldom": "^0.8.15",
    "async-mutex": "^0.5.0",
    "axios": "^1.7.4",
    "lit": "^3.3.3",
    "lodash": "^4.17.21",
    "split.js": "^1.6.5",
    "xpath": "^0.0.35"
  }
}
