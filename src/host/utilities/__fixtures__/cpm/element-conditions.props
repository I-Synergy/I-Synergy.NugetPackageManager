<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Condition="$(TargetFramework.StartsWith('net'))">
    <PackageVersion Include="Pkg.Element" Version="1.0.0" Condition="$(TargetFramework.StartsWith('net10.0'))" />
    <PackageVersion Include="Pkg.Element" Version="2.0.0" Condition="$(TargetFramework.StartsWith('net11.0'))" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="Pkg.Element" Version="3.0.0" />
    <PackageVersion Include="Pkg.Plain" Version="4.0.0" />
  </ItemGroup>
</Project>
