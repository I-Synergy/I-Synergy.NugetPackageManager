<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Condition="$(TargetFramework.StartsWith('net'))">
    <PackageVersion Include="Pkg.Repeat" Version="1.0.0" />
  </ItemGroup>
  <ItemGroup Condition="$(TargetFramework.StartsWith('net10.0'))">
    <PackageVersion Include="Pkg.Repeat" Version="2.0.0" />
  </ItemGroup>
  <ItemGroup Condition="$(TargetFramework.StartsWith('net'))">
    <PackageVersion Include="Pkg.Repeat" Version="3.0.0" />
  </ItemGroup>
</Project>
